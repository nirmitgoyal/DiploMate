  "fixed_sql": [
    {
      "name": "specialities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"specialities\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"exam_type\" TEXT NOT NULL, \"slug\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chapters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chapters\" (\"id\" TEXT NOT NULL, \"speciality_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"slug\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"exam_weight\" INTEGER NOT NULL DEFAULT 0, \"content_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "topics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topics\" (\"id\" TEXT NOT NULL, \"chapter_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"slug\" TEXT NOT NULL, \"exam_theme\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "qnas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"qnas\" (\"id\" TEXT NOT NULL, \"topic_id\" TEXT NOT NULL, \"question\" TEXT NOT NULL, \"years\" TEXT NULL, \"marks\" INTEGER NULL, \"earns_marks\" TEXT NOT NULL, \"sections\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"images\" (\"id\" TEXT NOT NULL, \"qna_id\" TEXT NOT NULL, \"caption\" TEXT NOT NULL, \"content_description\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "image_blobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_blobs\" (\"image_id\" TEXT NOT NULL, \"bytes\" BLOB NOT NULL, \"sha256\" TEXT NOT NULL, PRIMARY KEY (\"image_id\"));"
        }
      ]
    },
    {
      "name": "pending_review_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_review_events\" (\"id\" TEXT NOT NULL, \"content_id\" TEXT NOT NULL, \"rating\" TEXT NOT NULL, \"shown_at\" INTEGER NOT NULL, \"revealed_at\" INTEGER NOT NULL, \"rated_at\" INTEGER NOT NULL, \"local_day\" TEXT NOT NULL, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
